+def test_partial_publication_recovery_is_digest_only_arm64_and_never_pushes_image():
+    workflow=(ROOT/".github/workflows/green-print-image-recovery.yml").read_text(encoding="utf-8")
+    parsed=yaml.safe_load(workflow)
+    job=parsed["jobs"]["recover"]
+    steps=job["steps"]
+    names=[step.get("name") for step in steps]
+    assert parsed["env"]["IMAGE_SOURCE_COMMIT"]=="b75153f274d17aa62c05cee562a961d5b8ec8027"
+    assert parsed["env"]["EXPECTED_DIGEST"]=="sha256:48d8d871740be4e315a1f108897da6617ce5c08cc5d20715398094140a8068f3"
+    assert "build-image@" not in workflow and "docker push" not in workflow
+    assert "cosign sign" not in workflow and "push: \"true\"" not in workflow
+    assert "--platform linux/arm64" in workflow
+    assert workflow.count('test "${resolved_digest}" = "${EXPECTED_DIGEST}"')==1
+    assert workflow.count("imagetools inspect")>=3
+    assert "Verify existing original-workflow signature" in names
+    assert names.index("Verify fixed tag, digest, arm64 platform and original OCI source") < names.index("Generate SPDX SBOM from exact linux arm64 digest")
+    assert names.index("Generate SPDX SBOM from exact linux arm64 digest") < names.index("Attest contained recovery provenance") < names.index("Preserve non-secret contained recovery packet")
+    assert 'GH_TOKEN: ${{ github.token }}' in workflow and "|| true" not in workflow
+
 def test_apparmor_denies_admin_and_broad_writes():
