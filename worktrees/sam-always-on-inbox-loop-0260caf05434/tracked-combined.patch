+++ b/modules/sales/sam_one_clarification_contract.py
@@ -124,6 +124,44 @@ def delivery_disposition(state: str) -> dict[str, Any]:
     }
 
 
+def bind_delivery_attempt(proposal: Mapping[str, Any], attempt_id: str) -> dict[str, Any]:
+    """Bind attempt/provider evidence to the exact prepared proposal tuple."""
+    proposal = dict(proposal or {})
+    binding = proposal.get("binding")
+    if proposal.get("allowed") is not True or not isinstance(binding, Mapping):
+        raise ValueError("eligible_proposal_required")
+    attempt_id = _clean(attempt_id)
+    if not attempt_id:
+        raise ValueError("attempt_id_required")
+    exact = {
+        "attempt_id": attempt_id,
+        "proposal_digest": _clean(proposal.get("proposal_digest")),
+        "claim_key": _clean(proposal.get("claim_key")),
+        **_json_safe(dict(binding)),
+    }
+    return {**exact, "attempt_digest": _digest(exact), "maximum_provider_attempts": 1}
+
+
+def validate_provider_evidence(attempt: Mapping[str, Any], evidence: Mapping[str, Any]):
+    """Reject provider evidence unless every durable attempt identity matches."""
+    attempt, evidence = dict(attempt or {}), dict(evidence or {})
+    exact_keys = (
+        "attempt_id", "attempt_digest", "proposal_digest", "claim_key", "account_id",
+        "inbox_id", "conversation_id", "inbound_message_id", "contact_id",
+        "chronology_hash", "missing_fact_key", "authority_event_id", "content_digest",
+    )
+    mismatches = [key for key in exact_keys if not attempt.get(key) or evidence.get(key) != attempt.get(key)]
+    disposition = delivery_disposition(evidence.get("state"))
+    return {
+        **disposition,
+        "valid": not mismatches,
+        "complete": not mismatches and disposition["complete"],
+        "quarantined": bool(mismatches) or disposition["quarantined"],
+        "mismatches": mismatches,
+        "retry_allowed": False,
+    }
+
+
 def _digest(value) -> str:
     return hashlib.sha256(json.dumps(_json_safe(value), sort_keys=True,
                                      separators=(",", ":")).encode()).hexdigest()
