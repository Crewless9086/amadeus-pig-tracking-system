+    job=envelope(); ledger=S.Ledger(str(tmp_path/f"drift-{source}-{field}.db"))
+    ledger.put_claim(job,"lease-token-1",(NOW+timedelta(minutes=5)).isoformat(),NOW)
+    canonical=Canonical(); canonical.state_value="claimed"; cups=Cups()
