+    def _admitted_environment(self,runtime,environ=None):
+        # Execute the actual narrow source function without importing the live
+        # execution stack; its internal redactor import remains real.
+        import ast
+        source=Path(__file__).resolve().parents[1]/'modules/charlie/mission_admission_delivery.py'
+        tree=ast.parse(source.read_text(encoding='utf8'))
+        function=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='admitted_agent_environment')
+        names={'RUNTIME_STATE_ENV','RUNTIME_MISSION_ENV','RUNTIME_GUARD_URL_ENV','RUNTIME_CAPABILITY_ENV'}
+        constants=[n for n in tree.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id in names for t in n.targets)]
+        scope={'Path':Path,'MissionAdmissionError':RuntimeError}
+        exec(compile(ast.Module(body=constants+[function],type_ignores=[]),str(source),'exec'),scope)
+        return scope['admitted_agent_environment'](runtime,environ)
+
