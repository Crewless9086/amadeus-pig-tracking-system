+class QualifiedFakeCursor:
+    """Explicit synthetic connection acknowledgement; not privilege/lock proof.
+
+    Preserve legacy SQL/result assertions separately from the new handshake.
+    Real database identity and policy concurrency are tested in PostgreSQL.
+    """
+    def __init__(self, cursor, connection):
+        self.delegate, self.connection = cursor, connection
+        self.guard_purpose = None
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *args):
+        return self.delegate.__exit__(*args)
+
+    def __getattr__(self, name):
+        return getattr(self.delegate, name)
+
+    def execute(self, sql, params=None):
+        self.guard_purpose = None
+        if "app_private.assert_charlie_mission_connection" in sql:
+            self.guard_purpose = params[0]
+            self.connection.guard_requests.append(self.guard_purpose)
+            return
+        return self.delegate.execute(sql, params)
+
+    def fetchone(self):
+        if self.guard_purpose:
+            return ("charlie_mission_connection_v1", self.connection.database_role, self.guard_purpose, True)
+        return self.delegate.fetchone()
 
 
