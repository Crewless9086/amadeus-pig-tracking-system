+                  where n.nspname='app_private' and p.proname='assert_charlie_mission_connection'),
+                  exists(select 1 from pg_catalog.pg_policy where polname=any(%s))""",
+        (["charlie_mission_application_access", "charlie_mission_application_hold_read"],),
+    ).fetchone()
+    if not target_present or any(target_present):
+        raise RuntimeError("migration_charlie_target_without_receipt")
+    roles = _verify_charlie_role_posture(connection, required=False)
+    if CHARLIE_WRITER_ROLE not in roles:
+        raise RuntimeError("migration_charlie_hold_writer_predecessor_missing")
+    _charlie_relation_kinds(connection)
+    _verify_charlie_functions(connection, guard=False)
+    _verify_charlie_hold_triggers(connection)
+    _verify_charlie_hold_relation(connection)
+    for relation in ("public.charlie_missions", CHARLIE_HOLD_RELATION):
+        _verify_charlie_visibility(connection, CHARLIE_WRITER_ROLE, relation, ("SELECT",))
+    return "predecessor"
