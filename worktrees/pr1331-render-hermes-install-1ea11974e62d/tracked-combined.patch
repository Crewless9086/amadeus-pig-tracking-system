+        tree=ast.parse(source.read_text(encoding='utf8'))
+        function=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='_run_codex_process')
+        class CapturedLaunch(RuntimeError):pass
+        captured=[]
