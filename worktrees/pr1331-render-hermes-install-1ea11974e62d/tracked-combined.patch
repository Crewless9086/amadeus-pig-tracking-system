+def _charlie_transition_snapshot(connection) -> dict:
+    bootstrap = connection.execute(
+        "select rolname from pg_catalog.pg_roles where oid=10 and rolsuper"
+    ).fetchone()
+    if not bootstrap:
+        raise RuntimeError("migration_charlie_bootstrap_grantor_unverified")
+    return {
+        "old_catalog": _catalog_manifest(connection, include_charlie=False),
+        "charlie_catalog": _catalog_manifest(
+            connection, relations=CHARLIE_CATALOG_RELATIONS,
+            functions=tuple("public." + name for name in CHARLIE_HOLD_FUNCTIONS), include_charlie=False,
+        ),
+        "authority": _charlie_role_catalog(connection),
+        "public_schema": [list(row) for row in connection.execute(
+            """select pg_catalog.pg_get_userbyid(n.nspowner),coalesce(r.rolname,'PUBLIC'),
+                      x.privilege_type,x.is_grantable
+                 from pg_catalog.pg_namespace n
+                 cross join lateral pg_catalog.aclexplode(
+                   coalesce(n.nspacl,pg_catalog.acldefault('n',n.nspowner))) x
+                 left join pg_catalog.pg_roles r on r.oid=x.grantee
+                where n.nspname='public' order by 1,2,3,4"""
+        ).fetchall()],
+        "owner": connection.execute("select current_user").fetchone()[0],
+        "bootstrap_grantor": bootstrap[0],
+    }
+
+
+def _verify_charlie_transition_preserved(connection, before: dict) -> None:
+    after = _charlie_transition_snapshot(connection)
+    if after["bootstrap_grantor"] != before["bootstrap_grantor"]:
+        raise RuntimeError("migration_charlie_transition_bootstrap_grantor_changed")
+    for key in ("old_catalog", "charlie_catalog"):
+        expected = json.loads(json.dumps(before[key]))
+        for role in CHARLIE_DATABASE_ROLES:
+            grant = ["app_private", role, "USAGE", False]
+            if grant not in expected["schema_acl"]:
+                expected["schema_acl"].append(grant)
+        expected["schema_acl"].sort()
+        if key == "charlie_catalog":
+            for relation, privileges in CHARLIE_APPLICATION_PRIVILEGES.items():
+                for privilege in privileges:
+                    grant = [*relation.split("."), CHARLIE_APPLICATION_ROLE, privilege, False]
+                    if grant not in expected["relation_acl"]:
+                        expected["relation_acl"].append(grant)
+                hold = relation == CHARLIE_HOLD_RELATION
+                expected["policies"].append([
+                    *relation.split("."),
+                    "charlie_mission_application_hold_read" if hold else "charlie_mission_application_access",
+                    "PERMISSIVE", CHARLIE_APPLICATION_ROLE, "SELECT" if hold else "ALL", "true", "" if hold else "true",
+                ])
+            expected["relation_acl"].sort()
+            expected["policies"].sort()
+        if after[key] != expected:
+            raise RuntimeError(f"migration_charlie_transition_unexpected_catalog_change:{key}")
+    old_memberships = before["authority"]["memberships"]
+    new_memberships = after["authority"]["memberships"]
+    had_application = any(row[0] == CHARLIE_APPLICATION_ROLE for row in before["authority"]["roles"])
+    if any(row not in new_memberships for row in old_memberships) or any(
+        row not in old_memberships and
+        (had_application or row != [CHARLIE_APPLICATION_ROLE, before["owner"], before["bootstrap_grantor"], True, False, False])
+        for row in new_memberships
+    ):
+        raise RuntimeError("migration_charlie_transition_unexpected_membership_change")
+    public_schema = [list(row) for row in before["public_schema"]]
+    if not public_schema:
+        raise RuntimeError("migration_charlie_transition_public_schema_missing")
+    for role in CHARLIE_DATABASE_ROLES:
+        grant = [public_schema[0][0], role, "USAGE", False]
+        if grant not in public_schema:
+            public_schema.append(grant)
+    if after["public_schema"] != sorted(public_schema):
+        raise RuntimeError("migration_charlie_transition_unexpected_public_schema_change")
+
