+        for name, spec in CHARLIE_HOLD_FUNCTIONS.items() if name.startswith("append_")
+    )
+    # A PUBLIC trigger function can also be attached to an attacker-owned table;
+    # admit only the exact historically reviewed hold trigger functions as well
+    # as the writer's two append entrypoints. Their bodies/owners/ACLs were checked
+    # above, and the complete effective surface is bound into the checkpoint.
+    permitted_triggers = [
+        ["public", name, spec[0], role, "f", owner]
+        for name, spec in CHARLIE_HOLD_FUNCTIONS.items() if spec[2] and not name.startswith("append_")
+        for role in CHARLIE_DATABASE_ROLES
+    ]
+    if (any(row not in authority["effective_definer_functions"] for row in expected_definers)
+        or any(row not in expected_definers + permitted_triggers for row in authority["effective_definer_functions"])):
+        raise RuntimeError("migration_charlie_effective_definer_function_mismatch")
+    policies = connection.execute(
+        """select schemaname,tablename,policyname,permissive,
+                  coalesce(array_to_string(roles,','),''),cmd,coalesce(qual,''),coalesce(with_check,'')
+             from pg_catalog.pg_policies where policyname=any(%s) order by 1,2,3""",
+        (["charlie_mission_application_access", "charlie_mission_application_hold_read"],),
+    ).fetchall()
+    expected_policies = sorted(
+        ("public", relation.split(".")[1],
+         "charlie_mission_application_hold_read" if relation == CHARLIE_HOLD_RELATION else "charlie_mission_application_access",
+         "PERMISSIVE", CHARLIE_APPLICATION_ROLE,
+         "SELECT" if relation == CHARLIE_HOLD_RELATION else "ALL", "true",
+         "" if relation == CHARLIE_HOLD_RELATION else "true")
+        for relation in CHARLIE_APPLICATION_PRIVILEGES
+    )
+    if policies != expected_policies:
+        raise RuntimeError("migration_charlie_named_policy_mismatch")
+    for relation, privileges in CHARLIE_APPLICATION_PRIVILEGES.items():
+        _verify_charlie_visibility(connection, CHARLIE_APPLICATION_ROLE, relation, privileges)
+    for relation in ("public.charlie_missions", CHARLIE_HOLD_RELATION):
+        _verify_charlie_visibility(connection, CHARLIE_WRITER_ROLE, relation, ("SELECT",))
+    # Explicit ACLs alone cannot exclude PUBLIC execution of an append function.
+    for identity in hold_functions:
+        if identity.split(".")[1].startswith("append_"):
+            for role in CHARLIE_DATABASE_ROLES:
+                allowed = connection.execute(
+                    """select pg_catalog.has_function_privilege(%s,p.oid,'EXECUTE')
+                         from pg_catalog.pg_proc p join pg_catalog.pg_namespace n on n.oid=p.pronamespace
+                        where (n.nspname||'.'||p.proname)=%s""", (role, identity),
+                ).fetchone()[0]
