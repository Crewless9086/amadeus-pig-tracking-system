+def _verify_charlie_visibility(connection, role: str, relation: str, privileges) -> None:
+    # Identifiers originate only in the static reviewed inventory above.
+    if relation not in CHARLIE_APPLICATION_PRIVILEGES or role not in CHARLIE_DATABASE_ROLES:
+        raise RuntimeError("migration_charlie_visibility_scope_invalid")
+    connection.execute("lock table " + relation + " in access share mode")
+    oid, rls = connection.execute(
+        "select oid,relrowsecurity from pg_catalog.pg_class where oid=pg_catalog.to_regclass(%s)",
+        (relation,),
+    ).fetchone()
+    if relation == CHARLIE_HOLD_RELATION and not rls:
+        raise RuntimeError("migration_charlie_hold_rls_disabled")
+    if not rls:
+        return
+    policies = connection.execute(
+        """select p.polcmd,p.polpermissive,
+                  pg_catalog.pg_get_expr(p.polqual,p.polrelid),
+                  pg_catalog.pg_get_expr(p.polwithcheck,p.polrelid)
+             from pg_catalog.pg_policy p
+            where p.polrelid=%s and
+              (0::oid=any(p.polroles) or (select oid from pg_catalog.pg_roles where rolname=%s)=any(p.polroles))""",
+        (oid, role),
+    ).fetchall()
+    for privilege in privileges:
+        command = {"SELECT": "r", "INSERT": "a", "UPDATE": "w"}[privilege]
+        applicable = [p for p in policies if p[0] in (command, "*")]
+        def unconditional(policy):
+            using, check = policy[2], policy[3]
+            return ((privilege == "INSERT" or using == "true")
+                    and (privilege == "SELECT" or (check if check is not None else using) == "true"))
+        if not any(p[1] and unconditional(p) for p in applicable) or any(
+            not p[1] and not unconditional(p) for p in applicable
+        ):
+            raise RuntimeError(f"migration_charlie_visibility_unverified:{role}:{relation}:{privilege}")
+
+
+def _verify_charlie_database_readback(connection) -> dict:
+    posture = _verify_charlie_role_posture(connection, required=True)
+    _verify_private_schema(connection, required=True)
+    kinds = _charlie_relation_kinds(connection)
+    hold_functions = _verify_charlie_functions(connection, guard=False)
+    hold_triggers = _verify_charlie_hold_triggers(connection)
+    hold_relation = _verify_charlie_hold_relation(connection)
