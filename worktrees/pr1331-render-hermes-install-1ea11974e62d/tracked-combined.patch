+def _verify_database_connection(cursor, purpose):
+    """Validate the authenticated principal and complete hold visibility in SQL.
+
+    The invoker function locks the hold relation until this transaction ends,
+    so policy DDL cannot invalidate its visibility proof before protected reads.
+    Factories and caller-supplied cursors receive the same check as real sockets.
+    """
+    # A function called in autocommit releases its relation lock before the
+    # subsequent hold SELECT. Reject that lifecycle, including injected cursors.
+    if getattr(getattr(cursor, "connection", None), "autocommit", None) is not False:
+        raise RuntimeError("charlie_mission_transaction_required")
+    cursor.execute("select * from app_private.assert_charlie_mission_connection(%s)", (purpose,))
+    row = cursor.fetchone()
+    roles = {"application": {"charlie_mission_application"},
+             "hold_writer": {"charlie_owner_execution_hold_writer"},
+             "hold_read": {"charlie_mission_application", "charlie_owner_execution_hold_writer"}}
+    if (purpose not in roles or not isinstance(row, (tuple, list)) or len(row) != 4
+            or row[0] != "charlie_mission_connection_v1" or row[1] not in roles[purpose]
+            or row[2] != purpose or row[3] is not True):
+        raise RuntimeError("charlie_mission_connection_contract_invalid")
+
+
+@contextmanager
+def _connect(database_url, connect_factory=None, *, purpose="application"):
+    if connect_factory is None:
+        import psycopg
+        connect_factory = lambda url: psycopg.connect(url, connect_timeout=3)
+    # The first guard statement begins a non-autocommit transaction. The
+    # connection context rolls it back on error and closes the connection.
+    with connect_factory(database_url) as connection:
+        with connection.cursor() as cursor:
+            _verify_database_connection(cursor, purpose)
+        yield connection
 
 
