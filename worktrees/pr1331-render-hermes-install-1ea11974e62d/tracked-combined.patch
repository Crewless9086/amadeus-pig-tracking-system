+    return {"migration_log_description_sha256": hashlib.sha256(description.encode()).hexdigest(),
+            "roles": posture, "application_relation_count": len(kinds),
+            "authority_sha256": _json_sha256(authority), "hold_functions": hold_functions,
+            "hold_triggers_sha256": _json_sha256(hold_triggers),
+            "hold_relation_sha256": _json_sha256(hold_relation),
+            "guard": guard_functions, "named_policy_count": len(policies),
