+def _verify_charlie_database_precondition(connection, *, already_applied: bool) -> str:
+    if already_applied:
+        _verify_charlie_database_readback(connection)
+        return "target"
+    _verify_migration_log(connection, CHARLIE_DATABASE_MIGRATION_ID, required=False)
+    target_present = connection.execute(
+        """select exists(select 1 from pg_catalog.pg_proc p
