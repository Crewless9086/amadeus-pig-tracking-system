+    authority = _charlie_role_catalog(connection)
+    expected_schema = sorted(
+        [schema, role, "USAGE", False] for schema in ("app_private", "public") for role in CHARLIE_DATABASE_ROLES
+    )
+    expected_tables = sorted(
+        [[*relation.split("."), kinds[relation], CHARLIE_APPLICATION_ROLE, privilege, False]
+         for relation, privileges in CHARLIE_APPLICATION_PRIVILEGES.items() for privilege in privileges]
+        + [["public", name, kinds["public." + name], CHARLIE_WRITER_ROLE, "SELECT", False]
+           for name in ("charlie_missions", "charlie_owner_execution_hold_events")]
+    )
+    expected_functions = sorted(
+        [["app_private", "assert_charlie_mission_connection", "requested_purpose text", role, "EXECUTE", False]
+         for role in CHARLIE_DATABASE_ROLES]
+        + [["public", name, spec[0], CHARLIE_WRITER_ROLE, "EXECUTE", False]
+           for name, spec in CHARLIE_HOLD_FUNCTIONS.items() if name.startswith("append_")]
+    )
+    if (authority["schema_grants"] != expected_schema
+        or authority["table_grants"] != expected_tables
+        or authority["column_grants"] or authority["function_grants"] != expected_functions):
+        raise RuntimeError("migration_charlie_explicit_grant_mismatch")
+    expected_effective = sorted([row[0], row[1], row[3], row[4]] for row in expected_tables)
+    if (authority["effective_table_privileges"] != expected_effective
